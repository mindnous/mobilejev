{
  "expo": {
    "name": "mobilejev",
    "slug": "mobilejev",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobilejev",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.mobilejev"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 240
        }
      ],
      "llama.rn",
      "./plugins/with-opencl-fix",
      "./plugins/with-small-apk",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a photo to send to the on-device model.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Use the camera to ask the on-device model about what it sees.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
